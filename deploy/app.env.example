# Template only. Keep actual configuration at /etc/supermew/app.env with restricted permissions.
# One KEY=value per line. Comments must be on separate lines. No export, expansion or backslashes.
# URL-encode reserved characters in database and Redis passwords. Use independent random credentials.
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
DATABASE_URL=postgresql+psycopg2://supermew:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/supermew
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379/0
ARK_API_KEY=REPLACE_WITH_MODEL_API_KEY
MODEL=REPLACE_WITH_REPORT_MODEL
# Optional industry role models; empty values inherit MODEL on the same BASE_URL/key.
INDUSTRY_PLANNER_MODEL=
INDUSTRY_SELECTOR_MODEL=
INDUSTRY_WRITER_MODEL=
INDUSTRY_REVIEW_MODEL=
# Per-question recovery limits (processing rounds, not individual API calls).
INDUSTRY_CONCLUSION_RECOVERY_ENABLED=true
INDUSTRY_RECOVERY_COLLECT_EVIDENCE=3
INDUSTRY_RECOVERY_REWRITE_CONCLUSION=3
INDUSTRY_RECOVERY_NARROW_CONCLUSION=2
INDUSTRY_RECOVERY_RETRY_GENERATION=2
INDUSTRY_RECOVERY_TOTAL=6
INDUSTRY_RECOVERY_NO_PROGRESS=2
# 0 omits max_tokens for question writing; the provider still has its own limit.
INDUSTRY_CONCLUSION_MAX_OUTPUT_TOKENS=0
INDUSTRY_PLANNER_TIMEOUT_SECONDS=120
INDUSTRY_SELECTOR_TIMEOUT_SECONDS=120
INDUSTRY_WRITER_TIMEOUT_SECONDS=360
INDUSTRY_REVIEW_TIMEOUT_SECONDS=240
# Cover small review groups before repairing malformed responses. No SDK retries.
INDUSTRY_REVIEW_MAX_REQUESTS=12
INDUSTRY_REVIEW_FORMAT_RETRIES=1
INDUSTRY_REVIEW_EXECUTION_RETRIES=1
INDUSTRY_REVIEW_RETRY_BACKOFF_SECONDS=2
INDUSTRY_REVIEW_RATE_LIMIT_BACKOFF_SECONDS=5
# 0 omits the local cap so fragment review can return complete JSON.
INDUSTRY_REVIEW_MAX_OUTPUT_TOKENS=0
BASE_URL=https://REPLACE_WITH_MODEL_ENDPOINT/v1
ASSISTANT_MODEL=REPLACE_WITH_ASSISTANT_MODEL
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=REPLACE_WITH_SEARCH_API_KEY
# Optional comma-separated ordered pool; takes precedence over the single key.
TAVILY_API_KEYS=
TAVILY_KEY_QUOTA_COOLDOWN_SECONDS=3600
TAVILY_KEY_RATE_LIMIT_COOLDOWN_SECONDS=60
TAVILY_KEY_WRAP_RECHECK_SECONDS=60
EXA_API_KEY=REPLACE_WITH_EXA_API_KEY
# Select the model and dimension together; validate against the actual model and collection.
EMBEDDING_MODEL=/opt/supermew/shared/models/REPLACE_WITH_MODEL_DIRECTORY
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=REPLACE_WITH_ACTUAL_DIMENSION
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
BM25_STATE_PATH=/opt/supermew/shared/data/bm25_state.json
RESEARCH_OBJECT_STORE=local
RESEARCH_LOCAL_STORE=/opt/supermew/shared/data/research_store
COMPANY_KNOWLEDGE_OBJECT_STORE=local
COMPANY_KNOWLEDGE_LOCAL_STORE=/opt/supermew/shared/data/company_knowledge
# Configure these before releasing managed company knowledge.
BAILIAN_KNOWLEDGE_API_KEY=
BAILIAN_KNOWLEDGE_BASE_URL=
BAILIAN_KNOWLEDGE_AGENT_ID=
BAILIAN_KNOWLEDGE_INDEX_ID=
LIBREOFFICE_SOFFICE_PATH=/usr/bin/soffice
DOCX_RENDER_QA_ENABLED=true
DOCX_RENDER_QA_REQUIRED=true
DOCX_RENDER_QA_WORKDIR=/opt/supermew/shared/data/docx-qa
RESEARCH_DEMO_ENABLED=false
WORKFLOW_RESUME_ENABLED=true
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
MAX_UPLOAD_BYTES=52428800
MAX_REQUEST_BYTES=54525952
MAX_JSON_BYTES=2097152
RESEARCH_MAX_CONCURRENT_RUNS=1
RESEARCH_MAX_RUNS_PER_USER=1
CORS_ALLOWED_ORIGINS=http://127.0.0.1:18010,http://localhost:18010
