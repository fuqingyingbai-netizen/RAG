# Template only. Keep actual configuration at /etc/supermew/app.env with restricted permissions.
# One KEY=value per line. Comments must be on separate lines. No export, expansion or backslashes.
# URL-encode reserved characters in database and Redis passwords. Use independent random credentials.
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
DATABASE_URL=postgresql+psycopg2://supermew:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/supermew
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@127.0.0.1:6379/0
ARK_API_KEY=REPLACE_WITH_MODEL_API_KEY
MODEL=REPLACE_WITH_REPORT_MODEL
BASE_URL=https://REPLACE_WITH_MODEL_ENDPOINT/v1
ASSISTANT_MODEL=REPLACE_WITH_ASSISTANT_MODEL
WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=REPLACE_WITH_SEARCH_API_KEY
# Select the model and dimension together; validate against the actual model and collection.
EMBEDDING_MODEL=/opt/supermew/shared/models/REPLACE_WITH_MODEL_DIRECTORY
EMBEDDING_DEVICE=cpu
DENSE_EMBEDDING_DIM=REPLACE_WITH_ACTUAL_DIMENSION
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
BM25_STATE_PATH=/opt/supermew/shared/data/bm25_state.json
RESEARCH_OBJECT_STORE=local
RESEARCH_LOCAL_STORE=/opt/supermew/shared/data/research_store
COMPANY_KNOWLEDGE_OBJECT_STORE=local
COMPANY_KNOWLEDGE_LOCAL_STORE=/opt/supermew/shared/data/company_knowledge
# Configure these before releasing managed company knowledge.
BAILIAN_KNOWLEDGE_API_KEY=
BAILIAN_KNOWLEDGE_BASE_URL=
BAILIAN_KNOWLEDGE_AGENT_ID=
BAILIAN_KNOWLEDGE_INDEX_ID=
LIBREOFFICE_SOFFICE_PATH=/usr/bin/soffice
DOCX_RENDER_QA_ENABLED=true
DOCX_RENDER_QA_REQUIRED=true
DOCX_RENDER_QA_WORKDIR=/opt/supermew/shared/data/docx-qa
RESEARCH_DEMO_ENABLED=false
WORKFLOW_RESUME_ENABLED=true
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
