# Install only after DNS points to this host and both certificate names are valid.
# This file is not enabled by the application deployment.
server {
    listen 80;
    server_name guanfuzhiyan.com www.guanfuzhiyan.com;
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/lib/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    server_name guanfuzhiyan.com www.guanfuzhiyan.com;
    server_tokens off;
    ssl_certificate /etc/letsencrypt/live/guanfuzhiyan.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/guanfuzhiyan.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=15552000" always;
    client_max_body_size 52m;
    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1800s;
    }
}
