{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": ["oss:GetBucketLocation", "oss:GetBucketInfo", "oss:ListObjects", "oss:ListMultipartUploads"],
      "Resource": ["acs:oss:*:*:YOUR-BACKUP-BUCKET"]
    },
    {
      "Effect": "Allow",
      "Action": ["oss:GetObject", "oss:PutObject", "oss:DeleteObject", "oss:AbortMultipartUpload", "oss:ListParts"],
      "Resource": ["acs:oss:*:*:YOUR-BACKUP-BUCKET/supermew-restic/*"]
    }
  ]
}
