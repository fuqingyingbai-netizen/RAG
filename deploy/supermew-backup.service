[Unit]
Description=Verified incremental offsite backup for SuperMew
After=supermew.service postgresql.service docker.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=-/etc/supermew/backup-oss.env
RuntimeDirectory=supermew-backup
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/supermew/ops/backup/backup_policy.py --run
Nice=10
CPUWeight=10
IOWeight=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=18000
TimeoutStopSec=180
