ARK_API_KEY= #7a
MODEL= #doubao-seed-2-0-pro-260215
GRADE_MODEL= #doubao-seed-2-0-lite-260215
FAST_MODEL= #doubao-seed-1-6-flash-250828
BASE_URL= #https://ark.cn-beijing.volces.com/api/v3

# Moonshot / Kimi（供 test/kimi_api_smoke.py 使用；不要提交真实密钥）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6

# OCR for webpage images, uploaded screenshots, and chart text extraction.
OCR_ENABLED=true
OCR_PROVIDER=baidu
OCR_PROVIDER_ORDER=tencent,baidu
OCR_API_KEY=
OCR_SECRET_KEY=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
OCR_TIMEOUT_SECONDS=12

# Qichacha MCP
QCC_API_KEY=
QCC_MCP_COMPANY_URL=https://agent.qcc.com/mcp/company/stream
QCC_MCP_RISK_URL=https://agent.qcc.com/mcp/risk/stream
QCC_MCP_IPR_URL=https://agent.qcc.com/mcp/ipr/stream
QCC_MCP_OPERATION_URL=https://agent.qcc.com/mcp/operation/stream
QCC_MCP_EXECUTIVE_URL=https://agent.qcc.com/mcp/executive/stream
QCC_MCP_HISTORY_URL=https://agent.qcc.com/mcp/history/stream

# Tianyancha MCP
TYC_API_KEY=
TENC_API_KEY=
TYC_MCP_URL=https://mcp.tianyancha.com/v1

# Xiniu MCP
XINIU_API_KEY=
XINIU_MCP_URL=https://vip.xiniudata.com/mcp
STRUCTURED_SOURCE_ENABLED=true
STRUCTURED_SOURCE_TIMEOUT_SECONDS=45
# One-hop professional-platform enrichment for direct affiliations confirmed
# during person research. Returned shareholders/subsidiaries are not recursed.
PERSON_AFFILIATION_STRUCTURED_ENABLED=true
PERSON_AFFILIATION_STRUCTURED_LIMIT=5

# Person-report editor is deliberately bounded. If either batch times out, the
# workflow keeps the already-written section drafts instead of failing delivery.
PERSON_REPORT_EDITOR_ENABLED=false
PERSON_REPORT_EDITOR_TIMEOUT_SECONDS=90
PERSON_REPORT_EDITOR_MAX_RETRIES=0
PERSON_REPORT_EDITOR_MAX_CHARS_PER_BATCH=12000
REPORT_SECTION_MAX_WORKERS=2
PERSON_REPORT_SECTION_TIMEOUT_SECONDS=150
PERSON_REPORT_SECTION_MAX_RETRIES=1
PERSON_REPORT_MIN_SOURCED_SECTIONS=8
PERSON_REPORT_MAX_FALLBACK_CHAPTERS=4
RESEARCH_STALE_RUN_MINUTES=15

# DOCX visual delivery QA. The backend automatically discovers the standard
# Windows LibreOffice install path even when soffice is not on PATH.
LIBREOFFICE_SOFFICE_PATH=
DOCX_RENDER_QA_ENABLED=true
DOCX_RENDER_QA_REQUIRED=false
DOCX_RENDER_QA_TIMEOUT_SECONDS=120
# Optional writable folder for LibreOffice temporary profile/output.
DOCX_RENDER_QA_WORKDIR=

# Web search APIs. Tavily/Exa receive native domain filters for authority searches.
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
EXA_API_KEY=
SERPER_API_KEY=
SERPAPI_API_KEY=
BRAVE_API_KEY=
BOCHA_API_KEY=
BOCHA_FETCH_ENABLED=false
WORKFLOW_RESUME_ENABLED=true
CLEANING_MODE=fast
CLEANING_LLM_ENABLED=false
# Stop additional industry refinement after repeated failures; body-text rule
# extraction and source retention continue. This counter resets on each run.
INDUSTRY_CLEANING_FAILURE_LIMIT=6
CLEANING_LLM_SOURCES_PER_MODULE=6
CLEANING_LLM_NEWS_PER_MODULE=4
CLEANING_LLM_STRUCTURED_PER_BUCKET=4
CLEANING_MAX_WORKERS=2
CLEANING_RAW_TEXT_LIMIT=20000
CLEANING_PROGRESS_EVERY=10
CLEANING_INSPECTION_SPLIT_MAX_DEPTH=2
# Optional secondary model used only when a cleaning batch is blocked or returns no valid JSON.
CLEANING_FALLBACK_MODEL=
CLEANING_FALLBACK_BASE_URL=
CLEANING_FALLBACK_API_KEY=
OCR_MAX_SOURCES_PER_RUN=5
OCR_MAX_IMAGES_PER_SOURCE=2
OCR_MAX_SECONDS_PER_RUN=90
OCR_MAX_RETRIES=1
OCR_RETRY_BASE_SECONDS=1.0

# Web source extraction controls.
WEB_SEARCH_QUERY_CONCURRENCY=3
WEB_FETCH_TIMEOUT_SECONDS=20
WEB_FETCH_MAX_CHARS=80000
WEB_FETCH_MIN_CHARS=600
# News summaries may be shorter but remain useful as B-level leads. They still
# require corroboration before supporting a hard conclusion.
ONLINE_NEWS_MIN_STORE_CHARS=80
ONLINE_NEWS_MIN_SUMMARY_CHARS=50
ONLINE_SOURCE_MAX_PER_HOST=8
ONLINE_AUTHORITY_SOURCE_MAX_PER_HOST=12
ONLINE_TECH_SOURCE_MAX_PER_PROJECT=25
# Set true only when report generation must stop if a required authority module has insufficient sources.
AUTHORITY_COVERAGE_REQUIRED=false
WEB_FETCH_PDF_MAX_PAGES=80
WEB_FETCH_PDF_OCR_MAX_PAGES=2
WEB_FETCH_PDF_RENDER_SCALE=2
WEB_RENDER_FALLBACK_ENABLED=true
WEB_RENDER_FETCH_BUDGET_PER_RUN=20
# Optional external reader/proxy fallback for pages blocked by simple requests.
# Example: set this only after confirming the provider URL pattern you want to use.
WEB_READER_FALLBACK_ENABLED=false
WEB_READER_FALLBACK_BASE=
# Optional cookies for login-required/protected sites.
# Global:
WEB_FETCH_COOKIE=
# Per-host example, dots and symbols become underscores and uppercase:
# WEB_FETCH_COOKIE_WWW_EXAMPLE_COM=sessionid=...

# Search engine results should not do heavy pre-fetching; the workflow controls source fetching.
SERPER_FETCH_ENABLED=false

# Text model timeout/retry controls.
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# 本地密集向量（langchain_huggingface / sentence-transformers）
EMBEDDING_MODEL= #BAAI/bge-m3
EMBEDDING_DEVICE= #cpu
DENSE_EMBEDDING_DIM= #1024

# ===== Rerank (可选，不配则自动降级) =====
RERANK_MODEL= #jina-reranker-v3
RERANK_BINDING_HOST= #https://api.jina.ai/v1/rerank
RERANK_API_KEY= #jina_

# ===== Milvus =====
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# BM25 稀疏统计持久化（默认项目根下 data/bm25_state.json）
# BM25_STATE_PATH=
# Managed company knowledge (Bailian RAG). API key stays on the server.
BAILIAN_KNOWLEDGE_API_KEY=
BAILIAN_KNOWLEDGE_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com
BAILIAN_KNOWLEDGE_AGENT_ID=
BAILIAN_KNOWLEDGE_INDEX_ID=
# Admins have access. Explicitly grant additional registered usernames here.
COMPANY_KNOWLEDGE_USERS=

# Industry chapter generation and single-attempt local repair (seconds).
INDUSTRY_SECTION_TIMEOUT_SECONDS=90
INDUSTRY_REPAIR_TIMEOUT_SECONDS=45
INDUSTRY_RISK_TIMEOUT_SECONDS=90
INDUSTRY_RISK_REPAIR_TIMEOUT_SECONDS=45
# Static trace examples are opt-in and explicitly marked as demo data.
RESEARCH_DEMO_ENABLED=false
# Industry cleaning enrichment: each batch shares a request/deadline budget.
INDUSTRY_CLEANING_TIMEOUT_SECONDS=60
INDUSTRY_CLEANING_BATCH_BUDGET_SECONDS=150
INDUSTRY_CLEANING_MAX_CALLS_PER_BATCH=3
INDUSTRY_CLEANING_SPLIT_MAX_DEPTH=1
